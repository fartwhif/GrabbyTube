# ── app settings (pydantic, prefix GRABBY_; see config.py) ─────────
GRABBY_HOST=0.0.0.0
GRABBY_PORT=8101
# Host-side sibling mounts make this path exist inside the container; the
# compose file mounts ../DrivePod/cache at /cache.
GRABBY_OUTPUT_DIR=/cache
GRABBY_MAX_CONCURRENT=2
GRABBY_PREFERRED_AUDIO_FORMAT=mp3
GRABBY_AUDIO_BITRATE=160k
GRABBY_AUDIO_BITRATE_MODE=cbr
GRABBY_AUDIO_SAMPLE_RATE=44100
GRABBY_AUDIO_CHANNELS=2

# Shared secret for the destructive / name-rewrite library endpoints (DrivePod
# sends it as X-Grabby-Token). Empty disables that auth.
GRABBY_API_TOKEN=<shared secret>

# LLM duplicate detection (optional; empty = gate off)
GRABBY_LLM_API_KEY=<bearer key>
GRABBY_LLM_BASE_URL=https://llm-backend.example.com/v1

# tunester pipeline container (shared docker network)
GRABBY_TUNESTER_URL=http://tunester:8102

# ── WireGuard tunnel to the VPS reverse proxy ──────────────────────
# The entrypoint reads these unprefixed names (NOT the legacy GRABBY_WG_* ones).
WG_PRIVATE_KEY=<wg genkey>
WG_ADDRESS=10.99.0.234/32
WG_PEER_PUBLIC_KEY=<server public key>
WG_PEER_ENDPOINT=<server-ip:port>
WG_PEER_PERSISTENT_KEEPALIVE=25
# This service runs full-tunnel mode, which is why entrypoint.sh re-adds the
# docker bridge route in table 51820. Narrow it to <server-wg-ip>/32 if you do
# not want the LAN and sibling containers pulled into the tunnel.
WG_PEER_ALLOWEDIPS=0.0.0.0/0
